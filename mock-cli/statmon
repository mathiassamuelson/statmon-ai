#!/usr/bin/env python3
"""Mock Statmon CLI returning realistic JSON for development.

Supports all querystore.* commands with common arguments.
Output is seeded by NODE_NAME env var for reproducible per-node variation.
"""

import json
import os
import random
import sys
import time

NODE_NAME = os.environ.get("NODE_NAME", "mock-node")
SEED = hash(NODE_NAME) % (2**32)

# Realistic DNS data pools
DOMAINS = [
    "example.com", "google.com", "facebook.com", "amazon.com", "netflix.com",
    "cloudflare.com", "github.com", "stackoverflow.com", "reddit.com",
    "wikipedia.org", "twitter.com", "linkedin.com", "apple.com", "microsoft.com",
    "cdn.example.net", "api.service.local", "mail.provider.com", "ns1.dns.co",
    "updates.vendor.io", "telemetry.app.net",
]

CLIENT_IPS = [
    "10.0.1.50", "10.0.1.51", "10.0.1.100", "10.0.1.101", "10.0.1.200",
    "192.168.1.10", "192.168.1.20", "192.168.1.30", "192.168.5.42",
    "172.16.0.5", "172.16.0.10", "172.16.0.15", "172.16.0.20", "172.16.0.25",
    "10.0.2.1", "10.0.2.2", "10.0.2.3", "10.0.2.50", "10.0.2.100",
    "192.168.10.5",
]

QUERY_TYPES = ["A", "AAAA", "CNAME", "MX", "NS", "PTR", "SOA", "SRV", "TXT"]
RESULT_CODES = ["noerror", "nxdomain", "servfail", "refused", "formerr"]
PROTOCOLS = ["UDP", "TCP", "HTTPS"]
VIEWS = ["default", "internal", "external", "dmz"]


def seeded_random(extra_seed=""):
    """Return a seeded Random instance for reproducible output."""
    rng = random.Random(SEED + hash(extra_seed))
    return rng


def parse_args(args):
    """Parse common querystore arguments from the command line.

    Supports both key=value syntax (production nom-tell style) and
    key value syntax (legacy/convenience).
    Examples:
        duration=3600 max-results=10 filter="((query-type (true (A AAAA))))"
        duration 3600 max-results 10 filter "(query-type (true (A AAAA)))"
    """
    parsed = {
        "duration": 3600,
        "max_results": 20,
        "filter": None,
        "interval": None,
        "source": "base",
        "anonymize": False,
        "group_by": None,
        "order": "descending",
    }

    KEY_MAP = {
        "duration": "duration",
        "max-results": "max_results",
        "filter": "filter",
        "interval": "interval",
        "source": "source",
        "anonymize": "anonymize",
        "group-by": "group_by",
        "order": "order",
        "end": None,  # accepted but ignored
    }

    i = 0
    while i < len(args):
        arg = args[i]

        # Handle key=value syntax
        if "=" in arg:
            key, value = arg.split("=", 1)
            mapped = KEY_MAP.get(key)
            if mapped == "duration":
                parsed["duration"] = int(value)
            elif mapped == "max_results":
                parsed["max_results"] = int(value)
            elif mapped == "filter":
                parsed["filter"] = value.strip("'\"")
            elif mapped == "interval":
                parsed["interval"] = value.strip("'\"")
            elif mapped == "source":
                parsed["source"] = value.strip("'\"")
            elif mapped == "anonymize":
                parsed["anonymize"] = value.lower() == "true"
            elif mapped == "group_by":
                parsed["group_by"] = value.strip("'\"")
            elif mapped == "order":
                parsed["order"] = value.strip("'\"")
            i += 1
            continue

        # Handle key value syntax (space-separated)
        if arg in KEY_MAP and i + 1 < len(args):
            mapped = KEY_MAP[arg]
            value = args[i + 1]
            if mapped == "duration":
                parsed["duration"] = int(value)
            elif mapped == "max_results":
                parsed["max_results"] = int(value)
            elif mapped == "filter":
                parsed["filter"] = value
            elif mapped == "interval":
                parsed["interval"] = value
            elif mapped == "source":
                parsed["source"] = value
            elif mapped == "anonymize":
                parsed["anonymize"] = value.lower() == "true"
            elif mapped == "group_by":
                parsed["group_by"] = value.strip("'\"")
            elif mapped == "order":
                parsed["order"] = value.strip("'\"")
            i += 2
        else:
            i += 1

    return parsed


def gen_top_clients(args, reverse=False):
    rng = seeded_random("clients")
    n = args["max_results"]
    clients = rng.sample(CLIENT_IPS, min(n, len(CLIENT_IPS)))
    counts = sorted(
        [rng.randint(100, 50000) for _ in clients], reverse=not reverse
    )
    return {
        "command": "querystore.bottom-clients" if reverse else "querystore.top-clients",
        "duration_seconds": args["duration"],
        "results": [
            {"client": ip, "query_count": count}
            for ip, count in zip(clients, counts)
        ],
    }


def gen_top_clients_by_size(args, field="request", reverse=False):
    rng = seeded_random(f"clients_{field}")
    n = args["max_results"]
    clients = rng.sample(CLIENT_IPS, min(n, len(CLIENT_IPS)))
    sizes = sorted(
        [rng.randint(10000, 5000000) for _ in clients], reverse=not reverse
    )
    return {
        "command": f"querystore.{'bottom' if reverse else 'top'}-clients-by-{field}-size",
        "duration_seconds": args["duration"],
        "results": [
            {"client": ip, f"{field}_bytes": sz}
            for ip, sz in zip(clients, sizes)
        ],
    }


