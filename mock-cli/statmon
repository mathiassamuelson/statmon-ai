def gen_top_views(args, reverse=False):
    rng = seeded_random("views")
    n = min(args["max_results"], len(VIEWS))
    views = rng.sample(VIEWS, n)
    counts = sorted(
        [rng.randint(1000, 100000) for _ in views], reverse=not reverse
    )
    return {
        "command": "querystore.bottom-views" if reverse else "querystore.top-views",
        "duration_seconds": args["duration"],
        "results": [
            {"view": v, "query_count": count}
            for v, count in zip(views, counts)
        ],
    }


def gen_count(args):
    rng = seeded_random("count")
    return {
        "command": "querystore.count",
        "duration_seconds": args["duration"],
        "count": rng.randint(10000, 500000),
    }


def gen_qps(args):
    rng = seeded_random("qps")
    return {
        "command": "querystore.qps",
        "duration_seconds": args["duration"],
        "qps": round(rng.uniform(5.0, 50.0), 2),
    }


def gen_bandwidth(args, direction="request"):
    rng = seeded_random(f"bw_{direction}")
    return {
        "command": f"querystore.{direction}-bandwidth",
        "duration_seconds": args["duration"],
        f"{direction}_bandwidth_bytes": rng.randint(1000000, 100000000),
    }


def gen_bandwidth_per_second(args, direction="request"):
    rng = seeded_random(f"bwps_{direction}")
    return {
        "command": f"querystore.{direction}-bandwidth-per-second",
        "duration_seconds": args["duration"],
        f"{direction}_bytes_per_second": round(rng.uniform(1000, 500000), 2),
    }


def gen_group_count(args):
    rng = seeded_random("group_count")
    group_by = args["group_by"] or "result-code"

    if group_by == "result-code":
        groups = {
            "noerror": rng.randint(50000, 200000),
            "nxdomain": rng.randint(5000, 50000),
            "servfail": rng.randint(100, 5000),
            "refused": rng.randint(10, 1000),
            "formerr": rng.randint(0, 100),
        }
    elif group_by == "query-type":
        groups = {
            "A": rng.randint(50000, 200000),
            "AAAA": rng.randint(30000, 150000),
            "CNAME": rng.randint(1000, 20000),
            "MX": rng.randint(500, 10000),
            "PTR": rng.randint(1000, 15000),
            "TXT": rng.randint(200, 5000),
            "NS": rng.randint(100, 3000),
            "SOA": rng.randint(50, 1000),
            "SRV": rng.randint(50, 2000),
        }
    elif group_by == "protocol":
        groups = {
            "UDP": rng.randint(100000, 300000),
            "TCP": rng.randint(10000, 50000),
            "HTTPS": rng.randint(1000, 20000),
        }
    else:
        groups = {
            f"{group_by}_value_{i}": rng.randint(100, 50000)
            for i in range(rng.randint(3, 8))
        }

    sorted_groups = dict(
        sorted(groups.items(), key=lambda x: x[1], reverse=args["order"] == "descending")
    )

    return {
        "command": "querystore.group-count",
        "duration_seconds": args["duration"],
        "group_by": group_by,
        "groups": sorted_groups,
        "total": sum(groups.values()),
    }


def gen_group_count_size(args):
    rng = seeded_random("group_count_size")
    group_by = args["group_by"] or "result-code"
    return {
        "command": "querystore.group-count-size",
        "group_by": group_by,
        "unique_groups": rng.randint(3, 50),
    }


def gen_replay(args):
    rng = seeded_random("replay")
    n = min(args["max_results"], 50)
    now = int(time.time())
    entries = []
    for i in range(n):
        entries.append({
            "timestamp": now - rng.randint(0, args["duration"]),
            "client": rng.choice(CLIENT_IPS),
            "domain": rng.choice(DOMAINS),
            "query_type": rng.choice(QUERY_TYPES),
            "result_code": rng.choice(RESULT_CODES),
            "protocol": rng.choice(PROTOCOLS),
            "request_size": rng.randint(28, 512),
            "response_size": rng.randint(44, 4096),
            "duration_us": rng.randint(100, 50000),
        })
    entries.sort(key=lambda e: e["timestamp"])
    return {
        "command": "querystore.replay",
        "duration_seconds": args["duration"],
        "entry_count": len(entries),
        "entries": entries,
    }


def gen_status(args):
    rng = seeded_random("status")
    return {
        "command": "querystore.status",
        "status": "active",
        "entries": rng.randint(100000, 5000000),
        "memory_used_bytes": rng.randint(50000000, 500000000),
        "oldest_entry_age_seconds": rng.randint(3600, 86400),
        "sources": ["base"],
    }


COMMAND_HANDLERS = {
    "querystore.top-clients": lambda a: gen_top_clients(a),
    "querystore.bottom-clients": lambda a: gen_top_clients(a, reverse=True),
    "querystore.top-clients-by-request-size": lambda a: gen_top_clients_by_size(a, "request"),
    "querystore.bottom-clients-by-request-size": lambda a: gen_top_clients_by_size(a, "request", True),
    "querystore.top-clients-by-response-size": lambda a: gen_top_clients_by_size(a, "response"),
    "querystore.bottom-clients-by-response-size": lambda a: gen_top_clients_by_size(a, "response", True),
    "querystore.top-domains": lambda a: gen_top_domains(a),
    "querystore.bottom-domains": lambda a: gen_top_domains(a, reverse=True),
    "querystore.top-domains-by-request-size": lambda a: gen_top_domains_by_size(a, "request"),
    "querystore.bottom-domains-by-request-size": lambda a: gen_top_domains_by_size(a, "request", True),
    "querystore.top-domains-by-response-size": lambda a: gen_top_domains_by_size(a, "response"),
    "querystore.bottom-domains-by-response-size": lambda a: gen_top_domains_by_size(a, "response", True),
    "querystore.top-views": lambda a: gen_top_views(a),
    "querystore.bottom-views": lambda a: gen_top_views(a, reverse=True),
    "querystore.count": gen_count,
    "querystore.qps": gen_qps,
    "querystore.request-bandwidth": lambda a: gen_bandwidth(a, "request"),
    "querystore.response-bandwidth": lambda a: gen_bandwidth(a, "response"),
    "querystore.request-bandwidth-per-second": lambda a: gen_bandwidth_per_second(a, "request"),
    "querystore.response-bandwidth-per-second": lambda a: gen_bandwidth_per_second(a, "response"),
    "querystore.group-count": gen_group_count,
    "querystore.group-count-size": gen_group_count_size,
    "querystore.replay": gen_replay,
    "querystore.status": gen_status,
}


def main():
    if len(sys.argv) < 2:
        print(json.dumps({"error": "No command specified", "available_commands": list(COMMAND_HANDLERS.keys())}))
        sys.exit(1)

    command = sys.argv[1]

    if command == "querystore.reset":
        print(json.dumps({"error": "querystore.reset is a destructive operation"}))
        sys.exit(1)

    handler = COMMAND_HANDLERS.get(command)
    if handler is None:
        print(json.dumps({"error": f"Unknown command: {command}"}))
        sys.exit(1)

    args = parse_args(sys.argv[2:])
    result = handler(args)
    result["node"] = NODE_NAME
    print(json.dumps(result, indent=2))


if __name__ == "__main__":
    main()
