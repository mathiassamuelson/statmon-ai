    counts = sorted(
        [rng.randint(50, 30000) for _ in domains], reverse=not reverse
    )
    return {
        "command": "querystore.bottom-domains" if reverse else "querystore.top-domains",
        "duration_seconds": args["duration"],
        "results": [
            {"domain": d, "query_count": count}
            for d, count in zip(domains, counts)
        ],
    }


